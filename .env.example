# ──────────────────────────────────────────────────────────────────────────────
# Moteur DM YD Studio : configuration. Copier ce fichier en .env et remplir.
# Ne jamais committer .env : il contient des secrets.
# ──────────────────────────────────────────────────────────────────────────────

# Serveur
NODE_ENV=production
PORT=3000
# Adresse publique HTTPS du moteur (sert aux webhooks Meta et aux images envoyées)
PUBLIC_BASE_URL=https://moteur.yd-studio.fr
TIMEZONE=Europe/Paris
LOG_LEVEL=info

# Base de données Postgres (Railway, Render, Supabase, Neon…).
# Vide = base locale PGlite dans DATA_DIR (pratique pour tester, pas pour la production).
DATABASE_URL=
DATA_DIR=./data

# ── IA (Claude) ───────────────────────────────────────────────────────────────
# Clé API : https://console.anthropic.com (différente de l'abonnement Claude.ai)
ANTHROPIC_API_KEY=
# Modèles (voir docs/05-ia-et-couts.md pour le choix)
AI_MODEL_CONVERSATION=claude-sonnet-5-5
AI_MODEL_EBAUCHE=claude-opus-5-5
AI_MODEL_ANALYSE=claude-haiku-5-5
AI_MODEL_PROSPECTION=claude-haiku-5-5
AI_EFFORT_CONVERSATION=low
AI_CACHE_TTL=1h
AI_SERVER_FALLBACK=true
# Seuil d'alerte mensuel (USD)
AI_MONTHLY_BUDGET_USD=150
# true = le moteur tourne mais n'envoie RIEN sur Instagram (test à blanc)
DRY_RUN=false

# ── Instagram (API officielle Meta) — voir docs/02-connexion-instagram.md ─────
IG_ACCOUNT_ID=
IG_ACCESS_TOKEN=
IG_APP_SECRET=
# Chaîne aléatoire de votre choix, à recopier dans l'app Meta (validation du webhook)
IG_VERIFY_TOKEN=
IG_GRAPH_VERSION=v26.0
IG_API_HOST=graph.instagram.com
IG_TYPING_INDICATOR=true
# Seulement après validation de la fonctionnalité « Human Agent » par Meta
IG_HUMAN_AGENT_TAG=false

# ── Studio ────────────────────────────────────────────────────────────────────
STUDIO_NAME=YD Studio
ASSISTANT_NAME=Nova
# Lien Calendly / Cal.com de l'appel de 10 minutes
BOOKING_URL=

# ── Rythme et relances ────────────────────────────────────────────────────────
# naturel (recommandé) | rapide | instantane
PACING_PROFILE=naturel
# Attente après le dernier message reçu avant de répondre (la personne écrit souvent en plusieurs fois)
REPLY_DEBOUNCE_SECONDS=8
# Relances automatiques, toujours dans les 24 h qui suivent le dernier message du prospect
RELANCES=3h,21h
# Durée de pause de l'IA quand l'équipe répond elle-même
HUMAN_TAKEOVER_PAUSE_HOURS=12
MAX_AI_TURNS_PER_CONVERSATION=40

# ── Cockpit, sécurité, MCP ────────────────────────────────────────────────────
COCKPIT_PASSWORD=
# 32 caractères aléatoires minimum (ex : openssl rand -hex 32)
SESSION_SECRET=
# Jeton pour l'accès MCP par HTTP (/mcp) ; vide = désactivé
MCP_TOKEN=

# ── Alertes à l'équipe (au moins un canal conseillé) ──────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
# Webhook Slack / Discord / Make / n8n
NOTIFY_WEBHOOK_URL=

# ── Ébauches ──────────────────────────────────────────────────────────────────
EBAUCHE_ENABLED=true
# Aperçu envoyé au prospect quand l'ébauche est prête : aucun | flou | complet
EBAUCHE_TEASER=aucun
# Chemin de Chromium si besoin (l'image Docker l'inclut déjà)
PLAYWRIGHT_CHROMIUM_PATH=

# ── Prospection assistée ──────────────────────────────────────────────────────
# Heure du scan quotidien (heure de Paris)
PROSPECTS_SCAN_AT=07:30
# Flux RSS d'actualité (levées de fonds…), séparés par des virgules
PROSPECTS_RSS=
